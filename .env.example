# Database (Neon PostgreSQL hoặc bất kỳ PostgreSQL nào)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=verify-full"

# JWT - Dùng chuỗi ngẫu nhiên dài ít nhất 32 ký tự
# Tạo bằng: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="your-strong-random-secret-here"

# Cloudinary - Upload ảnh bìa (đăng ký miễn phí tại cloudinary.com)
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"
# Hoặc dùng unsigned preset thay vì API key/secret:
# CLOUDINARY_UPLOAD_PRESET="your-preset-name"
# CLOUDINARY_UPLOAD_FOLDER="web-truyen/covers"

# URL chính thức, không có dấu / ở cuối. Bắt buộc cho OAuth, email và SEO.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Google OAuth
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Facebook OAuth
FACEBOOK_CLIENT_ID="your-facebook-app-id"
FACEBOOK_CLIENT_SECRET="your-facebook-app-secret"

# Resend - gửi email xác minh và đặt lại mật khẩu
RESEND_API_KEY="re_your_api_key"
MAIL_FROM="Mọt Chạm <no-reply@your-domain.com>"

# Cron Secret - bảo vệ endpoint tự động đăng chương (bắt buộc)
# Tạo bằng: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET="your-cron-secret-min-16-chars"
